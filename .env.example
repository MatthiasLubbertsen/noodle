# Copy this file to `.env` and fill in real values. `.env` is gitignored so
# secrets never get committed. On the server, place your real `.env` next to
# docker-compose.yml and `docker compose up -d` will pick it up via env_file.

# --- Slack tokens (required) ---
SLACK_USER_TOKEN=xoxp-your-user-token
SLACK_APP_TOKEN=xapp-your-app-token

# only this slack user id is allowed to DM noodle
USER_ID=U12345678

# --- OpenRouter / OpenAI-compatible ---
OPENAI_API_KEY=sk-or-your-key
AI_ENDPOINT=https://openrouter.ai/api
# openrouter model id, e.g. openai/gpt-4o-mini
MODEL=openai/gpt-4o-mini

# channels where noodle may reply to mentions (comma separated, or * for any)
ALLOWED_CHANNELS=

# --- pacing / tuning ---
CHUNK_DELAY_SECONDS=0.5
MAX_FRAGMENT_CHARS=200

# optional
LOG_LEVEL=INFO
