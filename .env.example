# Copy this file to `.env` and fill in real values. `.env` is gitignored so
# secrets never get committed. On the server, place your real `.env` next to
# docker-compose.yml and `docker compose up -d` will pick it up via env_file.

# --- Slack tokens (required) ---
SLACK_USER_TOKEN=xoxp-your-user-token
SLACK_APP_TOKEN=xapp-your-app-token

# only this slack user id is allowed to DM noodle
USER_ID=U12345678

# --- OpenRouter / OpenAI-compatible ---
OPENAI_API_KEY=sk-or-your-key
AI_ENDPOINT=https://openrouter.ai/api
# openrouter model id, e.g. openai/gpt-4o-mini
MODEL=openai/gpt-4o-mini
# embeddings model for persisted-memory semantic search, via hack club ai's
# /v1/embeddings endpoint (AI_ENDPOINT + "/embeddings"). cheap (~$0.01/1M
# tokens), not a :free model (those carry retention/quality tradeoffs)
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# channels where noodle may reply to mentions (comma separated, or * for any)
ALLOWED_CHANNELS=

# --- pacing / tuning ---
CHUNK_DELAY_SECONDS=0.5
# minimum seconds between unprompted (no-mention) replies in the same channel
UNPROMPTED_COOLDOWN_SECONDS=300

# --- daily dms (everything runs in Europe/Amsterdam time, not configurable) ---
# time noodle DMs a reminder to send today's @matthias-day ping ("HH:MM")
DAILY_PING_REMINDER=19:00
# time noodle DMs the wakey-wakey / special-day message (+ a separate hack
# club news message, only sent if there's something new)
DAILY_MORNING_DM=08:00
# optional: the slack usergroup id for @matthias-day (also matched by name)
MATTHIAS_DAY_GROUP_ID=

# --- channel join/leave analytics (leave WATCHED_CHANNEL_ID empty to disable) ---
# the one channel noodle watches joins/leaves in
WATCHED_CHANNEL_ID=
# where join/leave (+ @matthias-day group changes) get logged
LOGS_CHANNEL_ID=
# ephemeral welcome posted in the watched channel when someone joins (visible
# only to that person); "{user}" becomes a real mention of them
JOIN_EPHEMERAL_MESSAGE=hey {user}, welcome! say hi and introduce yourself :)

# --- extras (all optional; unset just disables that piece) ---
# end-of-day wrap-up dm, and weekly dms ("<mon..sun> HH:MM")
# matthias's OWN user token (xoxp, scope search:read). ONLY used to count today's
# messages incl. private channels - nothing else ever uses it. optional
MATTHIAS_USER_TOKEN=
DAILY_WRAPUP_DM=21:30
WEEKLY_JOURNAL=sun 18:00
WEEKLY_MUSIC=sun 18:30
# unprompted pings (github watcher) wait out quiet hours and stop at the cap
QUIET_HOURS=23:00-07:30
PROACTIVE_DAILY_CAP=10
# weather (open-meteo, no key needed). PRIVATE: your own places, only ever in .env.
# morning dm places (comma separated) and the default for the weather tool
WEATHER_LOCATIONS=
WEATHER_DEFAULT_LOCATION=
# last.fm (now playing): free api key from last.fm/api, plus your username
LASTFM_API_KEY=
LASTFM_USER=
# github: CLASSIC token with repo + notifications scopes (fine-grained tokens
# can't read notifications). enables the github tool + notification watcher
GITHUB_TOKEN=
GITHUB_USER=MatthiasLubbertsen
GITHUB_POLL_SECONDS=300

# link shortener api: base url (e.g. https://go.example.com/api/v1) + key (`lnk_...`, created on
# its /app/api page). the links tool is only on when BOTH are set; leave either empty to switch it off
LINKS_API_BASE=
LINKS_API_KEY=

# code sandbox shared secret (16+ random chars, e.g. `openssl rand -hex 24`). compose hands it to
# the sandbox container and to noodle. LEAVE EMPTY TO SWITCH THE SANDBOX OFF: noodle then doesn't
# offer run_code at all and the container idles. same idea for the other optional keys above
# (github, last.fm, freedom): no key, no tool
SANDBOX_TOKEN=

# optional
LOG_LEVEL=INFO
